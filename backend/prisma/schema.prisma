generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                                String              @id @default(cuid())
  email                                             String              @unique
  password                                          String?
  name                                              String
  avatar                                            String?
  googleId                                          String?             @unique
  microsoftId                                       String?             @unique
  createdAt                                         DateTime            @default(now())
  updatedAt                                         DateTime            @updatedAt
  coursesTaught                                     Course[]            @relation("CourseInstructor")
  joinedCourses                                     CourseEnrollment[]
  courseReviews                                     CourseReview[]
  forumPosts                                        ForumPost[]
  QuizResult                                        QuizResult[]
  helpfulVotes                                      ReviewHelpfulVote[]
  reviewReplies                                     ReviewReply[]
  conversations_conversations_participant1IdTousers conversations[]     @relation("conversations_participant1IdTousers")
  conversations_conversations_participant2IdTousers conversations[]     @relation("conversations_participant2IdTousers")
  messages                                          messages[]

  @@map("users")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime

  @@map("sessions")
}

model Course {
  id            String             @id @default(cuid())
  title         String
  language      String
  description   String
  level         String
  category      String
  hours         String
  public        String
  community     String
  discussions   String
  info          String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  instructorId  String
  instructor    User               @relation("CourseInstructor", fields: [instructorId], references: [id])
  enrollments   CourseEnrollment[]
  quizzes       CourseQuiz[]
  courseReviews CourseReview[]
  units         CourseUnit[]
  forumPosts    ForumPost[]
  words         Word[]
}

model CourseEnrollment {
  id         String       @id @default(cuid())
  userId     String
  courseId   String
  progress   String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  course     Course       @relation(fields: [courseId], references: [id])
  user       User         @relation(fields: [userId], references: [id])
  QuizResult QuizResult[]
}

model Word {
  id        String   @id @default(cuid())
  title     String
  type      String
  duration  String
  content   String
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id])
}

model CourseUnit {
  id          String         @id @default(cuid())
  title       String
  description String?
  position    Int
  courseId    String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  lessons     CourseLesson[]
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseLesson {
  id        String     @id @default(cuid())
  title     String
  type      String
  duration  Int?
  content   String?
  position  Int
  unitId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  unit      CourseUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

model ForumPost {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])
}

model CourseReview {
  id           String              @id @default(cuid())
  rating       Int
  review       String?
  userId       String
  courseId     String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  course       Course              @relation(fields: [courseId], references: [id])
  user         User                @relation(fields: [userId], references: [id])
  helpfulVotes ReviewHelpfulVote[]
  replies      ReviewReply[]
}

model ReviewReply {
  id        String       @id @default(cuid())
  content   String
  authorId  String
  reviewId  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  author    User         @relation(fields: [authorId], references: [id])
  review    CourseReview @relation(fields: [reviewId], references: [id])
}

model ReviewHelpfulVote {
  id        String       @id @default(cuid())
  userId    String
  reviewId  String
  createdAt DateTime     @default(now())
  review    CourseReview @relation(fields: [reviewId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  @@unique([userId, reviewId])
}

model conversations {
  id                                        String     @id
  participant1Id                            String
  participant2Id                            String
  createdAt                                 DateTime   @default(now())
  updatedAt                                 DateTime
  users_conversations_participant1IdTousers User       @relation("conversations_participant1IdTousers", fields: [participant1Id], references: [id])
  users_conversations_participant2IdTousers User       @relation("conversations_participant2IdTousers", fields: [participant2Id], references: [id])
  messages                                  messages[]

  @@unique([participant1Id, participant2Id])
}

model events {
  id        String   @id
  title     String
  date      DateTime
  time      String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model messages {
  id             String        @id
  content        String
  senderId       String
  conversationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  conversations  conversations @relation(fields: [conversationId], references: [id])
  users          User          @relation(fields: [senderId], references: [id])
}

model CourseQuiz {
  id             String       @id @default(cuid())
  courseId       String
  externalQuizId String
  title          String
  category       String?
  difficulty     String?
  lessonId       String?
  position       Int          @default(0)
  isActive       Boolean      @default(true)
  tags           String[]
  isCached       Boolean      @default(false)
  quizData       Json?
  cachedData     Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  QuizResult     QuizResult[]

  @@unique([courseId, externalQuizId])
  @@index([courseId])
  @@index([lessonId])
}

model QuizResult {
  id                String           @id @default(cuid())
  courseQuizId      String
  studentId         String
  enrollmentId      String
  externalSessionId String?
  score             Float
  totalQuestions    Int
  correctAnswers    Int
  timeSpent         Int
  answers           Json
  result            Json
  completedAt       DateTime         @default(now())
  CourseQuiz        CourseQuiz       @relation(fields: [courseQuizId], references: [id], onDelete: Cascade)
  CourseEnrollment  CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  users             User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseQuizId, studentId])
  @@index([studentId])
  @@index([courseQuizId])
  @@index([enrollmentId])
}
