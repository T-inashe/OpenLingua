generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String             @id @default(cuid())
  email         String             @unique
  password      String?
  name          String
  avatar        String?
  joinedCourses CourseEnrollment[]
  forumPosts    ForumPost[]
  googleId      String?            @unique
  microsoftId   String?            @unique

  // Courses taught
  coursesTaught Course[] @relation("CourseInstructor")

  // Reviews / Replies / Votes
  courseReviews   CourseReview[]
  reviewReplies   ReviewReply[]
  helpfulVotes    ReviewHelpfulVote[]

  // Chat
  conversations1 Conversation[] @relation("ConversationParticipant1")
  conversations2 Conversation[] @relation("ConversationParticipant2")
  sentMessages   Message[]

  // ✅ Add this to fix error
  quizResults QuizResult[] @relation("StudentQuizResults")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime

  @@map("sessions")
}

model Event {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  time      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("events")
}

model Conversation {
  id             String    @id @default(cuid())
  participant1Id String
  participant2Id String
  participant1   User      @relation("ConversationParticipant1", fields: [participant1Id], references: [id])
  participant2   User      @relation("ConversationParticipant2", fields: [participant2Id], references: [id])
  messages       Message[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([participant1Id, participant2Id])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  content        String
  senderId       String
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("messages")
}

model Course {
  id            String             @id @default(cuid())
  title         String
  language      String
  description   String
  level         String
  category      String
  hours         String
  public        String
  community     String
  discussions   String
  info          String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  instructorId  String
  instructor    User               @relation("CourseInstructor", fields: [instructorId], references: [id])
  enrollments   CourseEnrollment[]
  quizzes       CourseQuiz[]
  courseReviews CourseReview[]
  units         CourseUnit[]
  forumPosts    ForumPost[]
  words         Word[]

  @@index([instructorId])
  @@index([category])
  @@index([language])
  @@index([level])
  @@index([createdAt])
}

model CourseEnrollment {
  id         String       @id @default(cuid())
  userId     String
  courseId   String
  progress   String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  course     Course       @relation(fields: [courseId], references: [id])
  user       User         @relation(fields: [userId], references: [id])
  QuizResult QuizResult[]

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([createdAt])
}

model Word {
  id        String   @id @default(cuid())
  title     String
  type      String
  duration  String
  content   String
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id])
}

model CourseUnit {
  id          String         @id @default(cuid())
  title       String
  description String?
  position    Int
  courseId    String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  lessons     CourseLesson[]
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseLesson {
  id        String     @id @default(cuid())
  title     String
  type      String
  duration  Int?
  content   String?
  position  Int
  unitId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  unit      CourseUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

model ForumPost {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])

  @@index([courseId])
  @@index([authorId])
  @@index([createdAt])
}

model CourseReview {
  id           String              @id @default(cuid())
  rating       Int
  review       String?
  userId       String
  courseId     String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  course       Course              @relation(fields: [courseId], references: [id])
  user         User                @relation(fields: [userId], references: [id])
  helpfulVotes ReviewHelpfulVote[]
  replies      ReviewReply[]

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([userId])
  @@index([rating])
}

model ReviewReply {
  id        String       @id @default(cuid())
  content   String
  authorId  String
  reviewId  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  author    User         @relation(fields: [authorId], references: [id])
  review    CourseReview @relation(fields: [reviewId], references: [id])
}

model ReviewHelpfulVote {
  id        String       @id @default(cuid())
  userId    String
  reviewId  String
  createdAt DateTime     @default(now())
  review    CourseReview @relation(fields: [reviewId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  @@unique([userId, reviewId])
}

model CourseQuiz {
  id             String       @id @default(cuid())
  courseId       String
  externalQuizId String
  title          String
  category       String?
  difficulty     String?
  lessonId       String?
  position       Int          @default(0)
  isActive       Boolean      @default(true)
  tags           String[]
  isCached       Boolean      @default(false)
  quizData       Json?
  cachedData     Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  QuizResult     QuizResult[]

  @@unique([courseId, externalQuizId])
  @@index([courseId])
  @@index([lessonId])
}

model QuizResult {
  id                String           @id @default(cuid())
  courseQuizId      String
  studentId         String
  enrollmentId      String
  externalSessionId String?
  score             Float
  totalQuestions    Int
  correctAnswers    Int
  timeSpent         Int
  answers           Json
  result            Json
  completedAt       DateTime         @default(now())

  CourseQuiz        CourseQuiz       @relation(fields: [courseQuizId], references: [id], onDelete: Cascade)
  CourseEnrollment  CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  // ✅ Match relation with User
  student           User             @relation("StudentQuizResults", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseQuizId, studentId])
  @@index([studentId])
  @@index([courseQuizId])
  @@index([enrollmentId])
}

